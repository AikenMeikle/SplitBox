# ==============================================================================
# Divly — University of Birmingham Student Bulk-Buying Platform (.env.example)
# Copy this file to `.env` for local customization or set these in Railway/Render/Docker:
#   cp .env.example .env
# ==============================================================================

# --- Core Server & Database ---
# Port for the production server (in `npm run dev`, API uses 3001 and Vite uses 5173)
PORT=3000

# Path to the persistent SQLite database file (mount `/app/data` as a volume in Docker/Cloud)
SQLITE_PATH=data/divly.sqlite

# Public URL where students open Divly (used in Stripe return URLs and email links)
# Local dev: http://localhost:5173 | Production example: https://divly.co.uk
PUBLIC_BASE_URL=http://localhost:5173

# --- Campus Auth & Security ---
# Secret passphrase for logging into the Admin Dashboard (`/api/auth/admin-login`)
# IMPORTANT: Change this before going live!
ADMIN_PIN=uob-admin-2026

# Comma-separated list of emails allowed to sign in even if not `@student.bham.ac.uk`
# Anyone listed here also receives `admin` role upon OTP verification
ADMIN_EMAILS=founder@student.bham.ac.uk

# Secret key used to sign tamper-proof Saturday Hub QR Pickup Passes (HMAC-SHA256)
# Generate a fresh 64-character hex secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_HMAC_SECRET=replace-with-64-char-random-hex

# Keep `false` in production! Only set `true` on staging/demo servers if you want
# 1-click Demo Student / Demo Admin buttons visible without OTP verification.
ALLOW_DEV_LOGIN=false

# --- Optional: Real Stripe Checkout (Card, Apple Pay, Google Pay & Auto-Refunds) ---
# Leave blank to use the built-in simulated Test Checkout sheet during development.
# When set (`sk_test_...` or `sk_live_...`), Divly automatically switches to real Stripe Checkout!
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional: Real Student OTP Emails via Resend (https://resend.com — 3,000 free/mo) ---
# Leave blank in local dev to print 6-digit OTP codes to the terminal console.
# Set `RESEND_API_KEY` + verified sender domain to email real `@student.bham.ac.uk` inboxes!
RESEND_API_KEY=
EMAIL_FROM="Divly UoB <noreply@yourdomain.co.uk>"

# --- Optional: Live Wholesale B2B Ordering (Open Food Facts UK works with ZERO keys!) ---
# Note: Live UK product & EAN-13 barcode search in Admin (`GET /api/admin/wholesale/search`)
# queries Open Food Facts UK v2 out of the box with ZERO API keys needed!
# Add `QOGITA_API_KEY` (https://www.qogita.com) to enrich live B2B wholesale catalog pricing
# and submit automated wholesale purchase orders, OR set `WHOLESALE_ORDER_WEBHOOK_URL`
# (Zapier / Make / custom supplier EDI webhook) to push locked-case PO manifests automatically.
QOGITA_API_KEY=
WHOLESALE_ORDER_WEBHOOK_URL=
