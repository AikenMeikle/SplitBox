{
  "name": "divly-uob",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"PORT=3001 tsx watch server/index.ts\" \"vite --port 5173\"",
    "dev:api": "PORT=3001 tsx watch server/index.ts",
    "dev:web": "vite --port 5173",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production PORT=${PORT:-3000} npx tsx server/index.ts",
    "preview": "vite preview",
    "test": "npx tsx --test tests/backend.test.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  }
}
